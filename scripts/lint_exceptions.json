{
  "description": "No lint suppressions. Remove the suppression and express valid values and responsibilities in the code.",
  "existing": [],
  "configuration": {
    "Cargo.toml": {
      "lints": {},
      "workspace.lints": {
        "clippy": {
          "all": {
            "level": "warn",
            "priority": -1
          },
          "pedantic": {
            "level": "warn",
            "priority": -1
          },
          "missing_errors_doc": "warn",
          "missing_panics_doc": "warn",
          "module_name_repetitions": "warn",
          "allow_attributes": "deny",
          "allow_attributes_without_reason": "deny",
          "undocumented_unsafe_blocks": "deny"
        }
      }
    },
    "app/src-tauri/Cargo.toml": {
      "lints": {
        "workspace": true
      },
      "workspace.lints": {}
    },
    "app/ui/Cargo.toml": {
      "lints": {
        "workspace": true
      },
      "workspace.lints": {}
    },
    "crates/seamone-asr/Cargo.toml": {
      "lints": {
        "workspace": true
      },
      "workspace.lints": {}
    },
    "crates/seamone-core/Cargo.toml": {
      "lints": {
        "workspace": true
      },
      "workspace.lints": {}
    },
    "crates/seamone-runtime/Cargo.toml": {
      "lints": {
        "workspace": true
      },
      "workspace.lints": {}
    },
    "research/pyproject.toml": {
      "select": [
        "E",
        "W",
        "F",
        "I",
        "C90",
        "N",
        "UP",
        "B",
        "A",
        "C4",
        "SIM",
        "PLR",
        "PLW",
        "RUF"
      ],
      "mccabe": {
        "max-complexity": 15
      },
      "pylint": {
        "max-args": 8,
        "max-statements": 50
      },
      "ruff.line-length": 100,
      "ruff.target-version": "py312"
    }
  },
  "clippy_commands": [
    "cargo clippy --locked -p seamone -p seamone-runtime --all-targets $(WORKSPACE_FEATURE_ARGS) -- -D warnings",
    "cargo clippy --workspace --all-targets $(WORKSPACE_FEATURE_ARGS) -- -D warnings",
    "cargo clippy -p seamone-core -p seamone-ui --target wasm32-unknown-unknown -- -D warnings"
  ],
  "ruff_commands": {
    "research/Makefile": [
      "uv run ruff check .",
      "uv run ruff format --check .",
      "uv run ruff format ."
    ]
  }
}
