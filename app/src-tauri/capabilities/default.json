{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "앱에 포함된 main 창에서만 로컬 보관함 command를 사용한다",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-app-info",
    "allow-get-library",
    "allow-get-segments",
    "allow-import-audio",
    "allow-get-capture-status",
    "allow-transcribe-recording",
    "allow-select-model",
    "allow-get-playback",
    "allow-get-recording-playback",
    "allow-get-error-marks",
    "allow-save-error-mark",
    "allow-save-error-marks",
    "allow-playback-ended",
    "allow-save-review",
    "allow-dismiss-info",
    "allow-export-text",
    "allow-save-text-file",
    "allow-copy-saved-text"
  ]
}
